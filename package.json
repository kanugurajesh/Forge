{
  "name": "browserops-forge",
  "private": true,
  "version": "0.1.0",
  "description": "Compile one agent run into a trusted BrowserOps procedure, then share it.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/hub"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "tsx scripts/demo.ts",
    "hub": "tsx apps/hub/server/index.ts",
    "hub:dev": "concurrently -k \"tsx watch apps/hub/server/index.ts\" \"vite --config apps/hub/web/vite.config.ts\"",
    "build": "vite build --config apps/hub/web/vite.config.ts",
    "forge": "tsx packages/cli/src/index.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  }
}
